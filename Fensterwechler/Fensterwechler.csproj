<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WindowRotator</AssemblyName>
    <RootNamespace>Fensterwechler</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Window Rotator</Product>
    <Version>1.0.0</Version>
    <!-- WPF takes DPI awareness from app.manifest; the WinForms analyzer hint does not apply. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for NotifyIcon and Screen; avoid ambiguous WPF/WinForms names. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\app.ico" />
    <InternalsVisibleTo Include="Fensterwechler.Tests" />
  </ItemGroup>

</Project>
